# Canonical Formatter Configuration for {{TOOL_DISPLAY_NAME}}
# Enforces deterministic formatting, casing, column gutters, and indentation.

[formatting]
indent_width = 2
max_line_length = 100
uppercase_keywords = true
align_clauses = true
trim_trailing_whitespace = true
insert_final_newline = true

[naming]
enforce_iso_11179 = true
required_class_words = ["id", "nm", "dt", "ts", "amt", "qty", "val", "rt", "p", "ind", "cd"]

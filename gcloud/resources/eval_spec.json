{
  "tool_name": "gcloud",
  "prohibited_tokens": [
    "gsutil ",
    "bq query",
    "aws ",
    "az ",
    "shell=True",
    "gcloud docker",
    "| grep",
    "| awk",
    "activate-service-account --key-file"
  ],
  "required_tokens": [
    "--quiet",
    "--format="
  ],
  "naming_conventions": [
    "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
  ],
  "max_line_length": 140,
  "indent_step": 2
}
